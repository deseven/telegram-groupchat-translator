# ===============
# === General ===
# ===============

# Logging level (optional, default 'warn')
#LOG_LEVEL=info

# Port to listen HTTP requests on (optional, default '5005')
#PORT=5005

# Webhook base URL (required, https only)
WEBHOOK_URL=https://<YOUR_PUBLIC_DOMAIN>

# Bot token (required)
BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>

# Secret token used to verify incoming webhook requests (optional but recommended)
#WEBHOOK_SECRET=<YOUR_RANDOM_SECRET>

# admin user that will be able to control the bot (required)
ADMIN_USER_ID=999999999



# ===============================
# === OpenAI API ===
# ==================

# API key (required)
#OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# API endpoint (optional, default 'https://api.openai.com/v1')
#OPENAI_API_ENDPOINT=http://localhost/v1

# Model to use (optional, default 'gpt-4o-mini')
#OPENAI_MODEL=gpt-4o-mini

# Temperature (optional, default '0.2')
#OPENAI_TEMPERATURE=0.2

# Request timeout in milliseconds (optional, default '60000')
#OPENAI_TIMEOUT_MS=60000

# Use original message as a context for replies (optional, default 'false')
#OPENAI_USE_CONTEXT=false



# ==================
# === Retry ===
# ==================

# Number of retries on a failed translation (optional, default '10')
# Backoff delays are exponential: 1s, 2s, 4s, 8s, ...
#MAX_RETRIES=10

# Initial retry delay in milliseconds (optional, default '1000')
#RETRY_INITIAL_DELAY_MS=1000
